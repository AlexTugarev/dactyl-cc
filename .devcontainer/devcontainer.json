{
	"name": "Dactyl CC",
	"image": "mcr.microsoft.com/devcontainers/cpp:1-debian-12",
	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {
			"installZsh": true,
			"installOhMyZsh": true,
			"upgradePackages": true
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cmake-tools",
				"twxs.cmake",
				"Antyos.openscad"
			],
			"settings": {
				"cmake.configureOnOpen": true
			}
		}
	},
	"postCreateCommand": "sudo apt-get update && sudo apt-get install -y openscad && cd build && cmake ../src"
}
